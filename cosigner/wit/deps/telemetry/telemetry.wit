package enclave:telemetry@0.1.0;

/// Structured tracing, exported to AWS X-Ray.
///
/// The runtime roots one trace per guest invocation — an inbound request, a
/// task run, or a stream message — and ships it when that invocation ends. A
/// guest's events and spans attach to that trace; the runtime binds the tenant,
/// so **no function here accepts a tenant id** (the same rule as enclave:notify
/// and enclave:tasks). Calls made in a build with X-Ray switched off are
/// accepted and discarded, so a guest never has to branch on whether it is on.
///
/// Spans and events carry no secret by construction on the runtime's side: the
/// text and fields are the guest's own, and the runtime adds only what it
/// already knows (the tenant, the image, the region). What a guest puts in a
/// message or field is the guest's responsibility, exactly as with its stdout.
interface tracing {
    /// Severity. Mapped onto the runtime's own `tracing` levels for the console,
    /// and recorded on the X-Ray (sub)segment.
    enum level {
        trace,
        debug,
        info,
        warn,
        error,
    }

    /// A key/value annotation on an event or span. The value is a string the
    /// guest has already formatted; the runtime does not parse it. Keys are
    /// 1-64 characters of [A-Za-z0-9_.-].
    record field {
        key: string,
        value: string,
    }

    /// Record a point-in-time event on the span that is currently open (or on
    /// the invocation's root span if the guest has opened none). Cheap: there is
    /// no handle to keep.
    event: func(level: level, message: string, fields: list<field>);

    /// A unit of work with a duration, exported as an X-Ray subsegment of
    /// whichever span is open when it is created (the invocation's root span if
    /// none) — so spans nest by the order a guest opens them. The subsegment's
    /// end time is set when the span is closed: by `end`, or by dropping the
    /// resource, whichever comes first.
    resource span {
        /// Open a span beneath the currently-open span.
        constructor(level: level, name: string, fields: list<field>);

        /// Annotate the span after it has opened.
        set-field: func(key: string, value: string);

        /// Record a point-in-time event on this span.
        add-event: func(level: level, message: string, fields: list<field>);

        /// Close the span now. Dropping the resource without calling this closes
        /// it at the drop instead; calling it more than once does nothing.
        end: func();
    }
}

/// Metrics, published to AWS CloudWatch through the dedicated `PutMetricData`
/// API under the runtime's configured namespace.
///
/// As with tracing, the runtime binds the tenant and a guest cannot name it:
/// CloudWatch bills per unique dimension combination, so a tenant dimension is
/// the runtime's decision to make, not a guest's. Dimensions a guest does give
/// must be low cardinality. Calls made in a build with metrics switched off are
/// accepted and discarded.
///
/// A metric name is 1-255 printable ASCII characters. A call CloudWatch would
/// refuse — a bad name or dimension, a value that is not finite or is outside
/// CloudWatch's range — is dropped and counted rather than sent, because
/// CloudWatch refuses a whole request over one bad datum.
interface metrics {
    /// The unit a value is in, as CloudWatch names them. `none` leaves it unset.
    enum unit {
        none,
        count,
        seconds,
        milliseconds,
        bytes,
        kilobytes,
        percent,
    }

    /// A metric dimension: low cardinality only. 1-64 characters of
    /// [A-Za-z0-9_.-] each, and at most 10 per call.
    record dimension {
        name: string,
        value: string,
    }

    /// Add `value` to a counter (published as a Sum aggregation).
    counter-add: func(name: string, value: f64, dimensions: list<dimension>);

    /// Report a gauge's current value (published as-is).
    gauge-set: func(name: string, value: f64, %unit: unit, dimensions: list<dimension>);

    /// Record one observation into a distribution (published through
    /// CloudWatch's values/counts distribution).
    histogram-record: func(name: string, value: f64, %unit: unit, dimensions: list<dimension>);
}

/// What a guest includes to get both. Both are imports: the guest calls the
/// runtime, and there is nothing here for it to export.
world observed {
    import tracing;
    import metrics;
}
